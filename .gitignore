!tests/fixtures/**/*synthetic*.har
!tests/fixtures/**/*synthetic*.jsonl
!tests/fixtures/**/*synthetic*.ndjson
!tests/fixtures/**/*redacted*.har
!tests/fixtures/**/*redacted*.jsonl
!tests/fixtures/**/*redacted*.ndjson
!tests/fixtures/**/*sample*.har
!tests/fixtures/**/*sample*.jsonl
!tests/fixtures/**/*sample*.ndjson
!fixtures/**/*synthetic*.har
!fixtures/**/*synthetic*.jsonl
!fixtures/**/*synthetic*.ndjson
!fixtures/**/*redacted*.har
!fixtures/**/*redacted*.jsonl
!fixtures/**/*redacted*.ndjson
!fixtures/**/*sample*.har
!fixtures/**/*sample*.jsonl
!fixtures/**/*sample*.ndjson

# Logs, coverage, and profiling artifacts
*.log
*.log.*
*.profraw
/coverage/
/tarpaulin-report.html
/lcov.info

# Editor and OS noise
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
/.idea/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json

